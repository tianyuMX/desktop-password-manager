{
  "name": "desktop-password-manager-v1",
  "productName": "密码保险箱",
  "version": "1.0.0",
  "description": "一款本地优先、加密存储账号密码的桌面密码管理器。",
  "author": "Password Vault Team",
  "private": true,
  "main": ".vite/build/index.js",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "build": "vite build --config vite.renderer.config.ts",
    "typecheck": "vue-tsc --noEmit",
    "test:mailboxes": "node test-mailboxes.cjs",
    "test:safety": "node test-safety.cjs"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "pinia": "^3.0.3",
    "uuid": "^11.1.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.1",
    "vuetify": "^4.0.7"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.8.1",
    "@electron-forge/maker-deb": "^7.8.1",
    "@electron-forge/maker-rpm": "^7.8.1",
    "@electron-forge/maker-squirrel": "^7.8.1",
    "@electron-forge/maker-zip": "^7.8.1",
    "@electron-forge/plugin-vite": "^7.8.1",
    "@mdi/font": "^7.4.47",
    "@types/node": "^22.13.10",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^35.0.1",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-vuetify": "^2.1.3",
    "vue-tsc": "^2.2.8"
  }
}
